# Auction Scraper local config — read by core/env.py at startup.
# Process env vars take precedence over this file.

# How many parallel browser tabs the scrapers (IAAI search, bidfax lookup)
# may open at once. Raise to speed up; lower (=1) if rate-limited.
DEFAULT_TAB_CONCURRENCY=3

# Per-site overrides — uncomment to tune one auction independently. If
# unset, both fall back to DEFAULT_TAB_CONCURRENCY above.
# IAAI_TAB_CONCURRENCY=2
BIDFAX_TAB_CONCURRENCY=1

# When true, save a PNG per IAAI filter row + per bidfax try into logs/.
# Useful for diagnosing missing-lot / soft-block issues; disabled by
# default because each run otherwise produces hundreds of MB of imagery.
DEBUG_SCREENSHOTS=false

# How many days a cached bidfax result stays valid. Setting to 0 disables
# expiration. Cached lookups older than this are dropped on the next read
# and re-queried on the next run.
BIDFAX_CACHE_TTL_DAYS=60
